{
  "name": "@freva-org/data-inspector",
  "version": "2608.0.0",
  "description": "NetCDF / Zarr file inspection dialog - framework-agnostic Web Component",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freva-org/freva-web-nextgen.git",
    "directory": "packages/data-inspector"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite --config vite.dev.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.3",
    "happy-dom": "^20.8.9",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^4.1.3"
  }
}
