---
/**
 * The header: brand lockup as the route home, a tab list, an overflow `More` menu, a compact
 * `Menu` for narrow viewports, the theme toggle, and the account control when auth is enabled.
 *
 * The nodes are written at build time from validated configuration. The interactions that must
 * stay interactive - opening a menu, measuring overflow, switching theme - are re-attached by the
 * shell island to markup that already exists.
 */
import type { HeaderItemName, ResolvedPortalModel, Segment } from "../../../src/model/types.js";
import HeaderItems from "./HeaderItems.astro";
import NavPanel from "./NavPanel.astro";
import NavTab from "./NavTab.astro";

interface Props {
  model: ResolvedPortalModel;
  currentPath: string;
  slots?: Partial<Record<string, Segment[]>>;
}

const { model, currentPath, slots } = Astro.props;
const { site, chrome, navigation } = model;
const homeHref = site.basePath;
const authEnabled = model.enabledComponents.some((c) => c.kind === "auth");

/** The lockup's name, and the monogram drawn when there is no logo. */
const brandName = site.institution?.name ?? site.title;
const monogram = brandName
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0]!.toUpperCase())
  .join("");

/**
 * The tab list. The brand lockup *is* Home, so a tab pointing at the site root is not drawn a
 * second time. A consumer that declares one has not lost it - the lockup is the same destination,
 * and the entry is still in the compact menu below.
 */
const declared = [...navigation.header, ...chrome.header.links];
const tabs = declared.filter((link) => link.href !== homeHref);
/**
 * A tab is active on its own route, under its URL prefix, or on any page its outline lists - a
 * page whose frontmatter `path` published it outside the prefix still belongs to its section.
 */
const isActive = (href: string): boolean =>
  href === currentPath ||
  (href !== homeHref && currentPath.startsWith(href)) ||
  model.navOutline.some(
    (section) => section.href === href && section.pages.some((page) => page.href === currentPath),
  );

/**
 * Both navigation levels, as one tree, for the phone drill-down. Read from the model rather than
 * derived here: the panel has to know a section's pages while standing on a page in a different
 * section, which nothing in the rendered header knows, and a template may import a TYPE from the
 * model and nothing else, because the published package ships `dist/` and not `src/`.
 */
const outlineSections = model.navOutline;

/**
 * A customised portal renders the header from its parts (`HeaderItems.astro`), in the configured
 * order or the design's own; the arrangement below is then not used. A part a slot template moved
 * leaves its default place.
 */
const custom = model.customisation;
const moved: Partial<Record<string, HeaderItemName>> = {
  search: "search",
  "theme-toggle": "themeToggle",
  auth: "auth",
};
const headerItems: HeaderItemName[] =
  custom?.header.items ??
  (["brand", "links", "navToggle", "search", "themeToggle", "auth"] as HeaderItemName[]).filter(
    (item) => !custom?.movedParts.some((part) => moved[part] === item),
  );
---

{
  chrome.header.enabled && !custom && (
    <header class="portal-header" id="portal-header" data-scrolled="false" data-branding="on">
      <a class="portal-brand" href={homeHref} aria-label={`${brandName} - portal home`}>
        <span class="portal-brand-mark" aria-hidden="true" data-kind={site.identity.logo.url ? "logo" : "monogram"}>
          {site.identity.logo.url ? (
            <img class="portal-brand-logo" alt="" src={site.identity.logo.url} />
          ) : (
            monogram
          )}
        </span>
        <span class="portal-brand-text">
          <span class="portal-brand-name">{brandName}</span>
          {site.subtitle && <span class="portal-brand-tagline">{site.subtitle}</span>}
        </span>
      </a>

      <nav class="portal-nav" aria-label="Portal">
        <ul class="portal-nav-list">
          {tabs.map((link) => (
            <NavTab link={link} currentPath={currentPath} isActive={isActive} />
          ))}
        </ul>

        <div class="portal-menu portal-more">
          <button
            type="button"
            class="portal-nav-item portal-more-button"
            aria-expanded="false"
            aria-haspopup="true"
            aria-label="More navigation entries"
            hidden
          >
            More
          </button>
          <div class="portal-panel" role="menu" hidden />
        </div>

        {/*
          The compact control, deliberately NOT a `.portal-menu`: that class is what `initMenus()`
          binds the dropdown behaviour to, and this button opens the full-screen drill-down
          instead. Its panel stays in the markup as the no-script fallback, so a phone without the
          island still gets every destination.
        */}
        <div class="portal-compact">
          <button
            type="button"
            class="portal-nav-item portal-compact-button"
            aria-expanded="false"
            aria-haspopup="dialog"
            aria-controls="portal-navpanel"
            hidden
          >
            <Fragment set:html={`<svg class="portal-compact-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>`} />
            <span>Menu</span>
          </button>
          <noscript>
            <div class="portal-panel portal-compact-fallback" role="menu">
            {declared.flatMap((link) => [link, ...(link.links ?? [])]).map((link) => (
              <a
                class="portal-panel-item"
                role="menuitem"
                href={link.href}
                data-active={isActive(link.href) ? "true" : undefined}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
              >
                {link.label}
                {link.external && (
                  <span class="portal-visually-hidden"> (opens in a new tab)</span>
                )}
              </a>
            ))}
            </div>
          </noscript>
        </div>
      </nav>

      <div class="portal-header-controls">
        {/*
          The documentation search, when the deployment enabled it. `hidden` until the island
          starts: without JavaScript there is nothing behind the button, and a control that does
          nothing is worse than none. The index is fetched on first use, from this origin.
        */}
        {model.search && (
          <button
            type="button"
            class="portal-sitesearch-open"
            data-portal-sitesearch-open
            aria-haspopup="dialog"
            aria-controls="portal-sitesearch"
            hidden
          >
            <Fragment set:html={`<svg class="portal-sitesearch-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg>`} />
            <span class="portal-sitesearch-open-label">Search</span>
          </button>
        )}
        {/*
          The day/night control, in the Data Browser's own shape: a track with a knob that slides.
          Which icon shows and where the knob sits are decided by `:root[data-theme]` in the
          stylesheet, so it is correct on the first paint rather than rewritten by a script.
        */}
        <button
          type="button"
          class="portal-theme-toggle"
          role="switch"
          aria-checked="false"
          aria-label="Switch to dark theme"
          title="Toggle day / night"
        >
          <span class="portal-theme-knob" aria-hidden="true">
            <Fragment set:html={`<svg class="portal-theme-icon portal-theme-icon-moon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A8.5 8.5 0 1111.2 3a6.5 6.5 0 009.8 9.8z"/></svg><svg class="portal-theme-icon portal-theme-icon-sun" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19"/></svg>`} />
          </span>
        </button>
        <span class="portal-header-divider" aria-hidden="true" />
        {authEnabled && (
          <div
            class="portal-menu portal-account"
            data-portal-account
            data-portal-signed-in="false"
            hidden
          >
            <button
              type="button"
              class="portal-account-button"
              aria-expanded="false"
              aria-haspopup="true"
              aria-label="Account"
            >
              <span class="portal-avatar" aria-hidden="true">?</span>
              <span class="portal-account-label" data-portal-signed-out>Sign in</span>
              <span class="portal-account-label" data-portal-signed-in-label>Account</span>
              <span class="portal-caret" aria-hidden="true">▾</span>
            </button>
            <div class="portal-panel" role="menu" hidden>
              <button
                type="button"
                class="portal-panel-item"
                role="menuitem"
                data-portal-auth-action="login"
              >
                Sign in
              </button>
              <button
                type="button"
                class="portal-panel-item portal-panel-item-danger"
                role="menuitem"
                data-portal-auth-action="logout"
              >
                Sign out
              </button>
            </div>
          </div>
        )}
      </div>
    </header>
  )
}{chrome.header.enabled && custom && <HeaderItems model={model} currentPath={currentPath} slots={slots ?? {}} items={headerItems} />}

{
  /*
    The search dialog: a native modal `<dialog>`, which brings the focus trap, Escape and the
    inert page behind it for free. A combobox over a listbox, the ARIA pattern for "type, then
    pick": focus stays in the field, arrow keys move the active option, Enter follows it.
  */
  chrome.header.enabled && model.search && (
    <dialog
      class="portal-sitesearch"
      id="portal-sitesearch"
      aria-label="Search the documentation"
      data-portal-sitesearch-index={model.search.indexUrl}
      data-filters={model.search.facets.length > 0 ? "open" : undefined}
    >
      <div class="portal-sitesearch-main">
        <div class="portal-sitesearch-box">
          <Fragment set:html={`<svg class="portal-sitesearch-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg>`} />
          <input
            type="search"
            class="portal-sitesearch-input"
            role="combobox"
            aria-label={model.search.placeholder}
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="portal-sitesearch-results"
            placeholder={model.search.placeholder}
            autocomplete="off"
            spellcheck="false"
            maxlength="200"
          />
          {model.search.facets.length > 0 && (
            <button
              type="button"
              class="portal-sitesearch-filters-toggle"
              data-portal-sitesearch-filters-toggle
              aria-controls="portal-sitesearch-filters"
              aria-expanded="true"
              title="Filters"
            >
              <span class="portal-visually-hidden">Filters</span>
              <Fragment set:html={`<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>`} />
            </button>
          )}
          <button type="button" class="portal-sitesearch-close" data-portal-sitesearch-close>
            <span class="portal-visually-hidden">Close search</span>
            <kbd aria-hidden="true">Esc</kbd>
          </button>
        </div>
        <p class="portal-sitesearch-status" role="status" aria-live="polite"></p>
        <ul class="portal-sitesearch-results" id="portal-sitesearch-results" role="listbox" aria-label="Results"></ul>
      </div>
      {model.search.facets.length > 0 && (
        <aside class="portal-sitesearch-filters" id="portal-sitesearch-filters" aria-labelledby="portal-sitesearch-filters-title">
          <p class="portal-sitesearch-filters-title" id="portal-sitesearch-filters-title">Filters</p>
          <p class="portal-sitesearch-filters-group">Sections</p>
          <ul class="portal-sitesearch-facets">
            {model.search.facets.map((facet) => (
              <li>
                <button
                  type="button"
                  class="portal-sitesearch-facet"
                  data-portal-sitesearch-facet={facet.label}
                  aria-pressed="false"
                >
                  <span class="portal-sitesearch-facet-label">{facet.label}</span>
                  <span class="portal-sitesearch-facet-count">{facet.count}</span>
                </button>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </dialog>
  )
}

{
  chrome.header.enabled && (
    <NavPanel
      sections={outlineSections}
      currentPath={currentPath}
      homeHref={homeHref}
      brandName={brandName}
    />
  )
}

{
  chrome.header.prose && (
    <div class="portal-header-prose portal-prose">
      <Fragment set:html={chrome.header.prose.html} />
    </div>
  )
}
