      "td",
      "tfoot",
      "th",
      "thead",
      "tr",
      "ul"
    ],
    "globalAttributes": ["id", "class", "dir", "lang", "role", "title"],
    "elementAttributes": {
      "a": ["href", "rel", "target", "aria-label", "aria-describedby"],
      "img": [
        "src",
        "alt",
        "width",
        "height",
        "loading",
        "decoding",
