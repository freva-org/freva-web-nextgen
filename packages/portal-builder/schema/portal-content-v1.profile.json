{
  "profile": "portal-content-v1",
  "profileVersion": 1,
  "description": "The normative machine-readable rendering profile for FP-001 v1. A library default never decides any behavior listed here.",
  "markdown": {
    "base": "commonmark",
    "parser": {
      "package": "remark-parse",
      "range": "^11.0.0"
    },
    "extensions": {
      "gfm": {
        "package": "remark-gfm",
        "range": "^4.0.0",
        "enabled": ["autolinkLiteral", "footnote", "strikethrough", "table", "tasklist"]
      },
      "directive": {
        "package": "remark-directive",
        "range": "^4.0.0"
      },
      "math": {
        "package": "remark-math",
        "range": "^6.0.0"
      },
      "frontmatter": {
        "package": "remark-frontmatter",
        "range": "^5.0.0",
        "formats": ["yaml"]
      }
    },
    "containerDirectives": [
      "note",
      "seealso",
      "see-also",
      "abstract",
      "summary",
      "tldr",
      "info",
      "information",
      "todo",
      "tip",
      "hint",
      "important",
      "success",
      "check",
      "done",
      "question",
      "help",
      "faq",
      "warning",
      "caution",
      "attention",
      "failure",
      "fail",
      "missing",
      "danger",
      "error",
      "bug",
      "bugreport",
      "example",
      "quote",
      "cite"
    ],
    "leafDirectives": [],
    "textDirectives": [],
    "directiveAttributes": {
      "allowed": [],
      "labelIsTitle": true
    },
    "rawHtml": "reject",
    "mdx": "reject",
    "autolinkLiteral": {
      "bareWwwScheme": "https"
    },
    "tables": {
      "headerRow": "first-row",
      "note": "Header cells are recorded on the IR row and lowered to <thead>; the lowerer never promotes a row it was not told about."
    },
    "admonitions": {
      "$comment": "Source spellings normalized before parsing: Material for MkDocs (!!! type \"Title\", ??? and ???+ for collapsible), MyST (:::{type}), GitHub alerts (> [!TYPE]) and container directives (:::type[Title]). An unknown but safe type renders as a neutral note titled with the author's own word and reports PC1017; it never fails the build.",
      "kinds": [
        "note",
        "abstract",
        "info",
        "tip",
        "success",
        "question",
        "warning",
        "failure",
        "danger",
        "bug",
        "example",
        "quote"
      ],
      "collapsible": true,
      "unknownType": "neutral-note"
    }
  },
  "rst": {
    "base": "docutils-core",
    "helper": {
      "package": "freva-portal-rst",
      "version": "1.0.0"
    },
    "docutilsVersion": "0.23",
    "protocol": "portal-rst-ir/1",
    "allowedDirectives": [
      "note",
      "tip",
      "warning",
      "caution",
      "attention",
      "important",
      "admonition",
      "code",
      "code-block",
      "math",
      "image",
      "figure",
      "table",
      "list-table",
      "contents",
      "container",
      "danger",
      "error",
      "hint",
      "seealso"
    ],
    "forbiddenDirectives": ["raw", "include", "csv-table", "meta", "role", "default-role"],
    "allowedRoles": [
      "code",
      "emphasis",
      "literal",
      "math",
      "strong",
      "sub",
      "subscript",
      "sup",
      "superscript",
      "title-reference"
    ],
    "forbiddenRoles": ["raw"],
    "settings": {
      "file_insertion_enabled": false,
      "raw_enabled": false,
      "report_level": 2,
      "halt_level": 3,
      "input_encoding": "utf-8",
      "embed_stylesheet": false
    },
    "sphinxFeatures": "reject",
    "tables": {
      "headerRow": "docutils-thead",
      "note": "Docutils reports thead/tbody explicitly, and that is what is carried through the IR."
    }
  },
  "frontmatter": {
    "format": "yaml",
    "allowedKeys": ["title", "description", "path", "toc", "navOrder"],
    "types": {
      "title": "string",
      "description": "string",
      "path": "string",
      "toc": "boolean",
      "navOrder": "integer"
    },
    "maxDescriptionLength": 300,
    "removedBeforeParsing": true,
    "navOrderRange": [-10000, 10000]
  },
  "ir": {
    "nodeTypes": [
      "root",
      "paragraph",
      "heading",
      "text",
      "emphasis",
      "strong",
      "delete",
      "inlineCode",
      "code",
      "link",
      "image",
      "list",
      "listItem",
      "blockquote",
      "thematicBreak",
      "table",
      "tableRow",
      "tableCell",
      "tableCaption",
      "admonition",
      "math",
      "inlineMath",
      "diagram",
      "footnoteReference",
      "footnoteDefinition",
      "break",
      "definitionList",
      "definitionTerm",
      "definitionDescription",
      "figure",
      "caption",
      "legend",
      "container",
      "tableOfContents",
      "subscript",
      "superscript"
    ],
    "locationProvenance": {
      "kinds": ["parser", "inherited", "generated"],
      "rules": {
        "parser": "The parser reported a start line for this node. file is the normalized source-root-relative path and line is one-based. column and endLine/endColumn appear only when the parser reported them faithfully.",
        "inherited": "The parser reported no position for this node type. The location is copied from the identified origin node named by originRule and the node is never labelled parser-provided.",
        "generated": "The node was created by a named transform or is document-global. transform names the transform; line is omitted when no single source position exists."
      },
      "perNodeType": {
        "root": {
          "kind": "generated",
          "transform": "document"
        },
        "tableOfContents": {
          "kind": "generated",
          "transform": "toc"
        },
        "footnoteDefinition": {
          "kind": "parser",
          "fallback": "inherited",
          "originRule": "parent-document-first-child"
        },
        "tableRow": {
          "kind": "parser",
          "fallback": "inherited",
          "originRule": "nearest-ancestor-with-position"
        },
        "tableCell": {
          "kind": "parser",
          "fallback": "inherited",
          "originRule": "nearest-ancestor-with-position"
        },
        "text": {
          "kind": "parser",
          "fallback": "inherited",
          "originRule": "nearest-ancestor-with-position"
        },
        "caption": {
          "kind": "parser",
          "fallback": "inherited",
          "originRule": "parent-figure"
        },
        "definitionTerm": {
          "kind": "parser",
          "fallback": "inherited",
          "originRule": "nearest-ancestor-with-position"
        },
        "definitionDescription": {
          "kind": "parser",
          "fallback": "inherited",
          "originRule": "nearest-ancestor-with-position"
        },
        "diagram": {
          "kind": "generated",
          "transform": "mermaid",
          "originRule": "origin-code-node"
        },
        "math": {
          "kind": "parser",
          "fallback": "inherited",
          "originRule": "nearest-ancestor-with-position"
        },
        "inlineMath": {
          "kind": "parser",
          "fallback": "inherited",
          "originRule": "nearest-ancestor-with-position"
        },
        "*": {
          "kind": "parser",
          "fallback": "inherited",
          "originRule": "nearest-ancestor-with-position"
        },
        "subscript": {
          "kind": "parser",
          "fallback": "inherited",
          "originRule": "nearest-ancestor-with-position"
        },
        "superscript": {
          "kind": "parser",
          "fallback": "inherited",
          "originRule": "nearest-ancestor-with-position"
        },
        "tableCaption": {
          "kind": "parser",
          "fallback": "inherited",
          "originRule": "nearest-ancestor-with-position",
          "$comment": "The authored title of `.. table::`. It lowers to <caption> inside <table>, never to <figcaption>, which is why it is a distinct node type from `caption`."
        },
        "legend": {
          "kind": "parser",
          "fallback": "inherited",
          "originRule": "parent-figure",
          "$comment": "The longer body of a docutils or MyST figure, which follows its short caption."
        },
        "figure": {
          "kind": "parser",
          "fallback": "inherited",
          "originRule": "nearest-ancestor-with-position",
          "$comment": "A figure created by the caption-attachment pass keeps the position of the block it wraps, so a diagnostic points at the author’s image or code fence rather than at the caption."
        }
      },
      "originRules": {
        "nearest-ancestor-with-position": "The closest enclosing node for which the parser reported a line.",
        "parent-figure": "The enclosing figure node. A caption without one is generated.",
        "parent-document-first-child": "The document's first child that carries a parser position.",
        "origin-code-node": "The fenced code node the transform consumed."
      }
    }
  },
  "headings": {
    "tocDepth": [2, 3],
    "tocDefault": true,
    "slug": {
      "unicodeNormalization": "NFKD",
      "caseFold": "lowercase",
      "removeMarks": true,
      "removePunctuation": "\\p{P}\\p{S}",
      "keep": "\\p{L}\\p{N}",
      "whitespaceReplacement": "-",
      "collapseRepeatedSeparators": true,
      "trimSeparators": true,
      "emptyFallback": "section",
      "duplicateSuffix": "-{n}",
      "duplicateStart": 2,
      "maxLength": 96
    },
    "titleSource": ["frontmatter.title", "first-h1"],
    "demoteAuthoredH1": true
  },
  "highlighting": {
    "engine": {
      "package": "shiki",
      "range": "^3.14.0"
    },
    "theme": "github-light",
    "languages": [
      "bash",
      "c",
      "console",
      "cpp",
      "css",
      "diff",
      "docker",
      "fortran-fixed-form",
      "fortran-free-form",
      "html",
      "ini",
      "javascript",
      "json",
      "jsonc",
      "julia",
      "make",
      "markdown",
      "nginx",
      "python",
      "r",
      "rst",
      "rust",
      "shell",
      "sql",
      "toml",
      "typescript",
      "xml",
      "yaml"
    ],
    "unknownLanguage": "warn-and-escape",
    "classPrefix": "portal-code",
    "output": "class-only",
    "stylesheet": "assets/portal-code.css",
    "colorClassPrefix": "portal-code-c",
    "note": "Highlighting never emits an inline style attribute: token colours become deterministic classes plus one framework stylesheet, so the output stays CSP friendly. Two themes are tokenized and paired into one class per colour pair, so code is readable in the light and the dark portal theme.",
    "darkTheme": "github-dark"
  },
  "mermaid": {
    "engine": {
      "package": "mermaid",
      "range": "^11.16.0"
    },
    "renderAt": "build",
    "idPrefix": "portal-diagram-",
    "deterministicIds": true,
    "securityLevel": "strict",
    "sanitizeOutput": true
  },
  "math": {
    "engine": {
      "package": "katex",
      "range": "^0.16.0"
    },
    "renderAt": "build",
    "output": "html",
    "throwOnError": true,
    "strict": true,
    "trust": false,
    "macros": {}
  },
  "urls": {
    "allowedSchemes": ["https", "mailto"],
    "forbiddenSchemes": ["javascript", "vbscript", "file", "data", "http", "blob", "ftp"],
    "allowRootRelative": true,
    "allowRelative": true,
    "dataUriMediaTypes": [],
    "requireInternalTargetToExist": true
  },
