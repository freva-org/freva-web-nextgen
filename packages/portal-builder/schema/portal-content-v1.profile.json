      "generatedTransforms": ["katex", "mermaid", "portal-code", "shiki"],
      "note": "The namespace list constrains authored content. A pinned transform owns its own class vocabulary and is tagged as generated in the tree."
    },
    "$comment": "",
    "generatedElements": {
      "$comment": "Elements a *pinned framework transform* may emit that authored content may not. Authored raw HTML is rejected outright (markdown.rawHtml: reject; the RST helper produces IR, not HTML), so nothing an author writes can reach these.",
