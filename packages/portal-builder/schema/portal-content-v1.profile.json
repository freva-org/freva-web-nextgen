      "mover": ["accent", "displaystyle"],
      "munder": ["accentunder", "displaystyle"],
      "munderover": ["accent", "accentunder", "displaystyle"],
      "mroot": ["displaystyle"],
      "msqrt": ["displaystyle"],
      "mrow": ["displaystyle"],
      "mtable": ["rowspacing", "columnspacing", "columnalign", "rowalign", "displaystyle"],
      "mtd": ["rowspan", "columnspan", "columnalign", "rowalign"],
      "mpadded": ["width", "height", "depth", "lspace", "voffset"],
      "menclose": ["notation"],
      "msub": ["displaystyle"],
      "msup": ["displaystyle"],
      "msubsup": ["displaystyle"],
      "mfrac": ["linethickness", "displaystyle"],
      "details": ["open"],
      "button": [
