      "td": ["colspan", "rowspan", "headers", "scope", "align"],
      "th": ["colspan", "rowspan", "headers", "scope", "abbr", "align"],
      "ol": ["start", "reversed", "type"],
      "li": ["value", "data-portal-task"],
      "section": ["aria-label", "aria-labelledby"],
      "nav": ["aria-label", "aria-labelledby"],
      "div": ["aria-label", "aria-labelledby", "data-portal-code"],
      "span": ["aria-hidden", "data-portal-marker", "aria-label"],
      "code": ["data-portal-language"],
