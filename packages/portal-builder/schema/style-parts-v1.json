{
  "$comment": "The public styling API of portal-style-v1, version 1. Everything a portal-style-v1 stylesheet may name is listed here; anything else is rejected. Adding an entry is a minor change; renaming or removing one needs a new version (docs/customisation.md, 'Versioning').",
  "version": 1,
  "profile": "portal-style-v1",
  "parts": {
    "skip-link": {
      "description": "The 'Skip to main content' link.",
      "protected": true
    },
    "header": {
      "description": "The header landmark.",
      "protected": true,
      "containsProtected": true
    },
    "header-brand": {
      "description": "The brand lockup: the home link."
    },
    "header-logo": {
      "description": "The logo image inside the brand lockup."
    },
    "header-title": {
      "description": "The site or institution name inside the brand lockup."
    },
    "header-nav": {
      "description": "The header's navigation landmark: the tabs, the overflow menu and the small-screen menu button.",
      "protected": true,
      "containsProtected": true
    },
    "header-links": {
      "description": "The list of header tabs."
    },
    "header-link": {
      "description": "One header tab."
    },
    "nav-toggle": {
      "description": "The small-screen menu button.",
      "protected": true
    },
    "header-extra": {
      "description": "The headerExtra slot's container."
    },
