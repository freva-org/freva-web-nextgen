{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freva.org/portal/v1/subsite-policy.schema.json",
  "title": "static-docs-v1 trusted subsite capability policy",
  "description": "The only same-origin active-subsite capability profile in FP-001 v1. It accepts no raw CSP, no script origin, no unsafe-inline, no unsafe-eval and no consumer JavaScript.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "entryPoints", "runtime"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profile": { "const": "static-docs-v1" },
    "entryPoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[^/\\\\][^\\\\]*\\.html$",
        "maxLength": 512,
        "description": "A normalized subsite-relative HTML path that MUST exist in the copied tree."
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connectOrigins", "frameOrigins", "workers"],
      "properties": {
        "connectOrigins": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/exactOrigin" },
          "description": "Additional exact HTTPS origins. Same-origin connections are always permitted by this profile; wildcards are forbidden."
        },
        "frameOrigins": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/exactOrigin" }
        },
        "workers": { "enum": ["none", "self"] }
      }
    }
  },
  "$defs": {
    "exactOrigin": {
      "type": "string",
      "pattern": "^https://[a-z0-9.-]+(:[0-9]{1,5})?$",
      "maxLength": 256
    }
  }
}
