{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freva.org/portal/v1/component-evidence.schema.json",
  "title": "component-evidence.json",
  "description": "What the build graph and the copy manifest actually contained. Absence is proved here, not inferred from filenames or CSS.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "components", "graph"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "enabled",
          "ownedModuleRoots",
          "ownedStaticRoots",
          "assetNamespaces"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "ownedModuleRoots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ownedStaticRoots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assetNamespaces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowedSharedModules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "modules": {
            "type": "array",
            "description": "Normalized source-graph membership actually observed in the bundle.",
            "items": {
              "type": "string"
            }
          },
          "chunks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "copiedRoots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "copiedFiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "routes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "emittedServiceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunks", "modules"],
      "properties": {
        "chunks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "modules"],
            "properties": {
              "file": {
                "type": "string"
              },
              "isEntry": {
                "type": "boolean"
              },
              "modules": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "copiedFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "moduleBytes": {
          "type": "object",
          "description": "Rendered bytes per normalized module id, as the bundler reported them. It is what the size budgets are measured against.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "customisation": {
      "type": "object",
      "additionalProperties": false,
      "description": "portal-style-v1 and portal-template-v1 inputs, and what the builder removed from them because the feature they style is disabled. Present only when a portal uses a stylesheet or slot templates.",
      "required": ["stylesheet", "templates"],
      "properties": {
        "stylesheet": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "file", "prunedRules"],
              "properties": {
                "source": {
                  "type": "string"
                },
                "file": {
                  "type": "string"
                },
                "prunedRules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["selector", "features", "line"],
                    "properties": {
                      "selector": {
                        "type": "string"
                      },
                      "features": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "line": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "templates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slot", "source", "parts", "emptyParts"],
            "properties": {
              "slot": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "parts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "emptyParts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["part", "feature"],
                  "properties": {
                    "part": {
                      "type": "string"
                    },
                    "feature": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
