{
  "name": "@freva-org/freva-client-terminal",
  "version": "2608.0.0",
  "description": "Reusable, framework-free terminal window for freva-client commands - UI only, zero runtime dependencies.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freva-org/freva-web-nextgen.git",
    "directory": "packages/freva-client-terminal"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:styles": "node scripts/gen-styles.mjs",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\"",
    "lint": "eslint src tests scripts"
  },
  "license": "BSD-3-Clause",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^25.9.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.4"
  }
}
