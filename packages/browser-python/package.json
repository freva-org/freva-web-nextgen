{
  "name": "@freva-org/browser-python",
  "version": "2610.1.0",
  "description": "Framework-independent browser Python engine: Pyodide in a dedicated Web Worker, with an interactive REPL, a browser Fetch filesystem for remote Zarr, and inline Matplotlib output.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freva-org/freva-web-nextgen.git",
    "directory": "packages/browser-python"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./prepare": {
      "types": "./bin/prepare.d.mts",
      "import": "./bin/prepare.mjs"
    },
    "./embed": {
      "types": "./dist/embed/index.d.ts",
      "import": "./dist/embed/index.js"
    },
    "./embed/examples": {
      "types": "./dist/embed/examples.d.ts",
      "import": "./dist/embed/examples.js"
    },
    "./display": {
      "types": "./dist/display/index.d.ts",
      "import": "./dist/display/index.js"
    },
    "./display.css": "./dist/display/display.css",
    "./session": {
      "types": "./dist/session/index.d.ts",
      "import": "./dist/session/index.js"
    },
    "./console": {
      "types": "./dist/console/index.d.ts",
      "import": "./dist/console/index.js"
    },
    "./console/auto": {
      "types": "./dist/console/auto.d.ts",
      "import": "./dist/console/auto.js"
    },
    "./console.css": "./dist/console/styles.css",
    "./worker": {
      "types": "./dist/worker/browser-python.worker.d.ts",
      "import": "./dist/worker/browser-python.worker.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./ui/bridge": {
      "types": "./dist/ui/python-bridge.d.ts",
      "import": "./dist/ui/python-bridge.js"
    },
    "./ui/local": {
      "types": "./dist/ui/python-chunks-local.d.ts",
      "import": "./dist/ui/python-chunks-local.js"
    },
    "./ui/framed": {
      "types": "./dist/ui/python-chunks-framed.d.ts",
      "import": "./dist/ui/python-chunks-framed.js"
    },
    "./ui/chooser": {
      "types": "./dist/ui/session-chooser.d.ts",
      "import": "./dist/ui/session-chooser.js"
    },
    "./ui/copy": {
      "types": "./dist/ui/code-copy.d.ts",
      "import": "./dist/ui/code-copy.js"
    },
    "./ui/code": {
      "types": "./dist/ui/code-run.d.ts",
      "import": "./dist/ui/code-run.js"
    },
    "./ui/code.css": "./dist/ui/code.css",
    "./ui/code-figure.html": "./dist/ui/code-figure.html",
    "./ui/notebook": {
      "types": "./dist/ui/notebook/index.d.ts",
      "import": "./dist/ui/notebook/index.js"
    },
    "./ui/notebook/sheet": {
      "types": "./dist/ui/notebook/notebook-sheet.d.ts",
      "import": "./dist/ui/notebook/notebook-sheet.js"
    },
    "./ui/notebook/embed": {
      "types": "./dist/ui/notebook/notebook-embed.d.ts",
      "import": "./dist/ui/notebook/notebook-embed.js"
    },
    "./ui/notebook.css": "./dist/ui/notebook.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/worker/browser-python.worker.js",
    "./dist/console/auto.js",
    "./dist/**/*.css"
  ],
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node scripts/gen-python-sources.mjs && node scripts/gen-console-styles.mjs && node scripts/gen-addon-pins.mjs",
    "build": "tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.build.json && node scripts/copy-console-css.mjs && node scripts/build-stamp.mjs write",
    "typecheck": "node scripts/gen-python-sources.mjs --check && node scripts/gen-console-styles.mjs --check && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src tests scripts demo browser-tests bin",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "node browser-tests/run.mjs",
    "test:browser:strict": "BROWSER_STRICT=1 npm run test:browser",
    "test:browser:index": "BROWSER_STRICT=1 BROWSER_PYTHON_PACKAGE_INDEX=1 npm run test:browser",
    "test:browser:network": "BROWSER_STRICT=1 BROWSER_PYTHON_NETWORK=1 npm run test:browser",
    "test:browser:paste": "node browser-tests/run.mjs console-paste-and-caret.mjs",
    "test:browser:zarr": "node browser-tests/run.mjs zarr.mjs",
    "test:browser:chromium": "BROWSER_STRICT=1 node browser-tests/run.mjs --engine chromium",
    "test:browser:firefox": "BROWSER_STRICT=1 node browser-tests/run.mjs --engine firefox",
    "test:browser:firefox:ci": "BROWSER_STRICT=1 node browser-tests/run.mjs --engine firefox --skip-engine-independent",
    "test:browser:webkit": "BROWSER_STRICT=1 node browser-tests/run.mjs --engine webkit",
    "check:bytes": "node scripts/check-bytes.mjs && node scripts/measure-console.mjs && node scripts/check-docs-sizes.mjs",
    "fixtures:build": "python3 scripts/make-zarr-fixtures.py",
    "demo": "node scripts/serve-demo.mjs",
    "prepack": "npm run build && npm run check:bytes",
    "test:packaging": "node tests/packaging/pack-and-install.mjs",
    "check:package": "npm run test:packaging && npm run check:bytes",
    "prepare-runtime": "node bin/freva-browser-python.mjs prepare-runtime",
    "gen:addons": "node scripts/gen-addon-pins.mjs"
  },
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@types/jquery": "^3.5.32",
    "@types/prismjs": "^1.26.5",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "pyodide": "314.0.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@freva-org/freva-client-terminal": "2610.0.0",
    "dompurify": "3.4.17",
    "jquery": "3.7.1",
    "jquery.terminal": "2.47.0",
    "prismjs": "1.30.0"
  },
  "bin": {
    "freva-browser-python": "./bin/freva-browser-python.mjs"
  }
}
