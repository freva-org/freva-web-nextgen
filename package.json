{
  "name": "freva-web-nextgen",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @freva-org/freva-client-terminal && npm run build --workspaces",
    "dev": "npm run dev       --workspaces --if-present",
    "test": "npm run test      --workspaces --if-present",
    "test:browser": "npm run test:browser -w @freva-org/databrowser",
    "test:browser:strict": "npm run test:browser:strict -w @freva-org/databrowser",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || echo \"husky not installed - git hooks were not set up. That is expected for a build-only or --omit=dev install; run npm ci at the repo root to get them.\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "bootstrap": "node scripts/bootstrap.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "closure": "node packages/portal-builder/scripts/source-closure.mjs",
    "sbom": "node packages/portal-builder/scripts/sbom.mjs",
    "licenses": "node packages/portal-builder/scripts/license-report.mjs",
    "stac:prepare": "npm run prepare:upstream -w @freva-org/stac-browser --",
    "stac:cache-key": "npm run cache-key -w @freva-org/stac-browser --"
  },
  "lint-staged": {
    "!(packages/stac-browser/.upstream/**)*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(packages/stac-browser/.upstream/**)*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^9.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.0.0",
    "globals": "^17.9.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "type": "module"
}
